{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "BUILD_TESTING": "ON" }
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "BUILD_TESTING": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "release", "configurePreset": "vs2022", "configuration": "Release" }
    ,{ "name": "debug-2026", "configurePreset": "vs2026", "configuration": "Debug" }
    ,{ "name": "release-2026", "configurePreset": "vs2026", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "vs2022", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "vs2022", "configuration": "Release", "output": { "outputOnFailure": true } }
    ,{ "name": "debug-2026", "configurePreset": "vs2026", "configuration": "Debug", "output": { "outputOnFailure": true } }
    ,{ "name": "release-2026", "configurePreset": "vs2026", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
